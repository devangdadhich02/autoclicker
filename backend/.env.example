# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Velora Auto Clicker"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (Supabase — free managed PostgreSQL) ────────────────────────────
# 1. Go to https://supabase.com → New Project
# 2. Settings → Database → Connection String → URI tab
# 3. Copy the URI, replace [YOUR-PASSWORD] with your DB password
# 4. Change "postgresql://" to "postgresql+asyncpg://"
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres:MyPass123@db.abcdefghijkl.supabase.co:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Browser / Playwright ─────────────────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_PROFILE_DIR=/data/browser_profiles
SCREENSHOT_DIR=/data/screenshots
BROWSER_RECYCLE_INTERVAL_HOURS=6

# ─── Automation ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=5
DEFAULT_POLL_INTERVAL_SECONDS=15
ACTION_RETRY_ATTEMPTS=3
ACTION_RETRY_DELAY_SECONDS=2
WATCHDOG_CHECK_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=120

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Initial Admin ────────────────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@velora.com
FIRST_ADMIN_PASSWORD=Admin@123
