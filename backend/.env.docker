APP_NAME=Velora Auto Clicker
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

SECRET_KEY=velora-secret-2024-xyzabc123456789

DATABASE_URL=postgresql://postgres.ggxepfdaaojwfkvimsdr:storngpassowrd@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

FIRST_ADMIN_EMAIL=admin@velora.com
FIRST_ADMIN_PASSWORD=Admin@123

BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_PROFILE_DIR=/data/browser_profiles
SCREENSHOT_DIR=/data/screenshots
BROWSER_RECYCLE_INTERVAL_HOURS=6

MAX_CONCURRENT_JOBS=5
DEFAULT_POLL_INTERVAL_SECONDS=15
ACTION_RETRY_ATTEMPTS=3
ACTION_RETRY_DELAY_SECONDS=2
WATCHDOG_CHECK_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO
LOG_DIR=/data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

ALLOWED_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:80"]

RATE_LIMIT_PER_MINUTE=60

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2