# ═══════════════════════════════════════════════════════════════════════════
#  Velora Auto Clicker — Docker + Supabase .env Template
#  Copy this file to .env and fill in YOUR values
#  cp backend/.env.docker backend/.env
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED: Generate a strong secret key ──────────────────────────────────
# Run this to generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=PASTE_YOUR_GENERATED_SECRET_KEY_HERE

# ── REQUIRED: Supabase Database URL ─────────────────────────────────────────
# 1. Go to https://supabase.com → Create free account → New Project
# 2. Project Settings → Database → Connection String → URI tab
# 3. Copy the string and replace [YOUR-PASSWORD] with your DB password
# 4. IMPORTANT: Change "postgresql://" → "postgresql+asyncpg://"
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── REQUIRED: Admin account ──────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@yourdomain.com
FIRST_ADMIN_PASSWORD=YourStrongPassword123!

# ── App settings ─────────────────────────────────────────────────────────────
APP_NAME=Velora Auto Clicker
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Browser / Playwright ─────────────────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_PROFILE_DIR=/data/browser_profiles
SCREENSHOT_DIR=/data/screenshots
BROWSER_RECYCLE_INTERVAL_HOURS=6

# ── Automation ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=5
DEFAULT_POLL_INTERVAL_SECONDS=15
ACTION_RETRY_ATTEMPTS=3
ACTION_RETRY_DELAY_SECONDS=2
WATCHDOG_CHECK_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=90

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ── CORS (add your domain when deploying live) ────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Redis (optional, only needed for Celery tasks) ───────────────────────────
# Leave as-is if not using Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
